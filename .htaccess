# Legacy analytics URL (file blocked on host; redirect to trafico.html)
# Domain preference: HTTPS + WWW (preferred host for Google Search Console)
# Legacy atlas (guion) URL → canonical clean path /atlas-landraces/
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Subdominios de pais (ar., cl., co., mx.) -> www: 301 conservando ruta y query (la URL no se toca).
  # UNA sola regla para todos los hosts. El flag CO deja una cookie cc_pais=ar|cl|co|mx (dominio
  # .cannabicultor.com, 60 min) para que el chat conserve el pais tras el redireccionamiento:
  # assets/config.js la lee, la pasa a sessionStorage y la borra.
  # Va antes de "Forzar HTTPS" para llegar a https://www en un solo salto. /robots.txt y los sitemaps
  # tambien redirigen (los subdominios no sirven ni robots.txt ni sitemaps propios).
  # /.well-known/ se excluye para no romper la validacion HTTP del certificado (AutoSSL) de cada subdominio.
  # Aun no hay rutas /ar/...: todo va a la misma ruta en www.
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com(:[0-9]+)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule ^(.*)$ https://www.cannabicultor.com/$1 [L,R=301,CO=cc_pais:%1:.cannabicultor.com:60:/]

  # Forzar HTTPS (por si acaso)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forzar WWW (dominio preferido)
  RewriteCond %{HTTP_HOST} ^cannabicultor\.com$ [NC]
  RewriteRule ^(.*)$ https://www.cannabicultor.com/$1 [L,R=301]

  # Redirect 301: Atlas antiguo (underscore) → Atlas correcto (guión)
  RewriteRule ^atlas_landraces/(.*)$ https://www.cannabicultor.com/atlas-landraces/$1 [L,R=301]

  # Redirect de la página principal antigua (por si aún se usa)
  RewriteRule ^atlas_landrace\.html$ https://www.cannabicultor.com/atlas-landraces/ [L,R=301]

  RewriteRule ^analytics\.html$ /trafico.html [R=301,L]

  # Onboarding antiguo → registro directo en el chat de la home
  RewriteRule ^empezar\.html$ /? [R=301,L]
  RewriteRule ^empezar-diario\.html$ /? [R=301,L]
  RewriteRule ^test\.html$ /? [R=301,L]

  # Legacy atlas (guion) → misma versión canónica limpia
  RewriteRule ^atlas-landrace\.html$ https://www.cannabicultor.com/atlas-landraces/ [L,R=301]

  # Campaña Alianza Cannabicultores: /ley-antitabaco → directorio
  RewriteRule ^ley-antitabaco$ /ley-antitabaco/ [R=301,L]

  # /informes/ no tiene portada: la lista de informes vive en la biblioteca
  RewriteRule ^informes/?$ https://www.cannabicultor.com/biblioteca/informes/ [L,R=301]
</IfModule>

# Block sensitive files from web access
<FilesMatch "^(\.env|\.git|package-lock\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
