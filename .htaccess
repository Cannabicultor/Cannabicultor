# Legacy analytics URL (file blocked on host; redirect to trafico.html)
# Domain preference: HTTPS + WWW (preferred host for Google Search Console)
# Legacy atlas (guion) URL → canonical clean path /atlas-landraces/
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Migración subdominios de país → www.cannabicultor.com/<pais>/ (FASE 1: freno) ──
  # ar./cl./co./mx. comparten docroot con www. Mientras dura la migración se sirven con
  # noindex y canonical (cabecera HTTP Link) a la URL equivalente bajo www. Sin 301 todavía.
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^$ - [E=CC_CANON:/%1/,E=CC_PAIS:1]
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^growshops\.html$ - [E=CC_CANON:/%1/growshops/,E=CC_PAIS:1]
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^asociaciones\.html$ - [E=CC_CANON:/%1/asociaciones/,E=CC_PAIS:1]
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^tiendas-cbd\.html$ - [E=CC_CANON:/%1/tiendas-cbd/,E=CC_PAIS:1]
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/(growshops|asociaciones|tiendas-cbd)\.html$
  RewriteRule ^(.+)$ - [E=CC_PAIS:1,E=CC_CANON:/$1]

  # ── Migración subdominios de país (FASE 2): 301 ar./cl./co./mx. → www.cannabicultor.com/<pais>/ ──
  # Antes de la regla HTTPS para resolver en un solo salto. Conserva ruta y query (R=301 añade la query).
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^$ https://www.cannabicultor.com/%1/ [R=301,L]
  # Directorios por tipo: solo AR tiene datos; cl/co/mx van a su portada hasta que existan /<pais>/<tipo>/
  RewriteCond %{HTTP_HOST} ^ar\.cannabicultor\.com$ [NC]
  RewriteRule ^(growshops|asociaciones|tiendas-cbd)\.html$ https://www.cannabicultor.com/ar/$1/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^(cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^(growshops|asociaciones|tiendas-cbd)\.html$ https://www.cannabicultor.com/%1/ [R=301,L]
  # Rutas que ya empiezan por el país (/ar/...): no se duplica el prefijo
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^((?:ar|cl|co|mx)/.*)$ https://www.cannabicultor.com/$1 [R=301,L]
  # Resto (login, app, assets...): misma ruta en www (no existe /ar/app.html)
  RewriteCond %{HTTP_HOST} ^(ar|cl|co|mx)\.cannabicultor\.com$ [NC]
  RewriteRule ^(.+)$ https://www.cannabicultor.com/$1 [R=301,L]

  # Forzar HTTPS (por si acaso)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Forzar WWW (dominio preferido)
  RewriteCond %{HTTP_HOST} ^cannabicultor\.com$ [NC]
  RewriteRule ^(.*)$ https://www.cannabicultor.com/$1 [L,R=301]

  # Redirect 301: Atlas antiguo (underscore) → Atlas correcto (guión)
  RewriteRule ^atlas_landraces/(.*)$ https://www.cannabicultor.com/atlas-landraces/$1 [L,R=301]

  # Redirect de la página principal antigua (por si aún se usa)
  RewriteRule ^atlas_landrace\.html$ https://www.cannabicultor.com/atlas-landraces/ [L,R=301]

  RewriteRule ^analytics\.html$ /trafico.html [R=301,L]

  # Onboarding antiguo → registro directo en el chat de la home
  RewriteRule ^empezar\.html$ /? [R=301,L]
  RewriteRule ^empezar-diario\.html$ /? [R=301,L]
  RewriteRule ^test\.html$ /? [R=301,L]

  # Legacy atlas (guion) → misma versión canónica limpia
  RewriteRule ^atlas-landrace\.html$ https://www.cannabicultor.com/atlas-landraces/ [L,R=301]

  # Campaña Alianza Cannabicultores: /ley-antitabaco → directorio
  RewriteRule ^ley-antitabaco$ /ley-antitabaco/ [R=301,L]

  # /informes/ no tiene portada: la lista de informes vive en la biblioteca
  RewriteRule ^informes/?$ https://www.cannabicultor.com/biblioteca/informes/ [L,R=301]
</IfModule>

# Block sensitive files from web access
<FilesMatch "^(\.env|\.git|package-lock\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Subdominios de país (migración en curso): noindex + canonical a www
  Header set X-Robots-Tag "noindex, follow" env=CC_PAIS
  Header set Link "<https://www.cannabicultor.com%{CC_CANON}e>; rel=canonical" env=CC_CANON
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
