# ==============================================
# Cannabicultor Data Pipeline - Variables de entorno
# Copia este archivo como .env y rellena con tus valores reales.
# NUNCA subas .env real al repositorio.
# ==============================================

# --- Base de datos (Supabase) ---
# Usa la SERVICE_ROLE key (la secreta, rol "service_role") para escrituras del pipeline.
# Obténla en Supabase Dashboard → Settings → API → copia "service_role" (JWT completo).
SUPABASE_URL=https://gfyrsrdnvgnhtsuexjkb.supabase.co
SUPABASE_SERVICE_KEY=PEGA_AQUI_LA_SERVICE_ROLE_KEY_COMPLETA_DESDE_EL_DASHBOARD_DE_SUPABASE

# --- Configuración de batches y delays (compartida por los workers) ---
BATCH=50
DELAY_MS=1500

# Opciones avanzadas
FORCE=0
TARGET_BREEDER_ID=

# --- Futuro: n8n ---
# N8N_PASSWORD=cannabicultor2026

# --- Futuro: proxies (ejemplo con proveedor residencial) ---
# PROXY_URL=http://user:pass@residential.proxy.provider:port
# PROXY_ROTATE_EVERY=50   # rota cada N requests

# --- Futuro: LLM / Ollama ---
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=llama3.1:8b
# SEMANTIC_COMPRESSION=1   # activa prompts optimizados

# --- Webhook hacia el dashboard (cuando actualices datos) ---
# DASHBOARD_WEBHOOK_URL=https://tu-dominio.com/api/refresh-cache
# (El admin-breeders.html puede escuchar o hacer polling por ahora)

# ==============================================
# SerpAPI (ALTAMENTE RECOMENDADO)
# ==============================================
# Para que el descubrimiento busque de verdad en "toda la red" usando Google
# (en vez de solo los sitios hardcodeados).
#
# 1. Regístrate gratis en https://serpapi.com
# 2. Copia tu API Key (el plan gratuito da bastantes créditos para uso manual)
# 3. Pégala en la línea de abajo (quita el "tu_clave_aqui")

SERPAPI_KEY=PEGA_AQUI_TU_SERPAPI_KEY_REAL_DE_https://serpapi.com/manage-api-key

# ==============================================
# NOTA: Este archivo se carga automáticamente
# cuando ejecutas ./run-discovery.sh o ./run-pipeline.sh
# ==============================================

# --- Otras fuentes / APIs (opcionales) ---
# LEAFLY_API_KEY=...   # si tuvieras acceso oficial (poco probable)
